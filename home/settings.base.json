{
  "language": "korean",
  "statusLine": { "type": "command", "command": "npx -y ccstatusline@2.2.30", "padding": 0 },
  "extraKnownMarketplaces": {
    "kjham-cc": { "source": { "source": "github", "repo": "kjham/kjham-cc" } }
  },
  "env": { "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet" },
  "autoCompactWindow": 300000,
  "promptCacheTtl": "1h",
  "skillOverrides": {
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:xlsx": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:import-memory": "name-only",
    "anthropic-skills:artifact-emulator": "name-only",
    "anthropic-skills:google-workspace": "name-only",
    "anthropic-skills:skill-creator": "name-only"
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$HOME/.claude/hooks/autorun.mjs\"", "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "node \"$HOME/.claude/hooks/token-guard.mjs\"", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "matcher": "compact|resume", "hooks": [{ "type": "command", "command": "node \"$HOME/.claude/hooks/autorun.mjs\"", "timeout": 10 }] },
      { "matcher": "startup", "hooks": [{ "type": "command", "command": "node \"$HOME/.claude/hooks/token-guard.mjs\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "CronCreate", "hooks": [{ "type": "command", "command": "node \"$HOME/.claude/hooks/token-guard.mjs\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$HOME/.claude/hooks/autorun.mjs\"", "timeout": 10 }] }
    ]
  },
  "enabledPlugins": {
    "usage-hud@kjham-cc": true,
    "fleet@kjham-cc": true,
    "session-nickname@kjham-cc": true,
    "long-turn-notify@kjham-cc": true,
    "compact-tool-rows@kjham-cc": true,
    "ko-guard@kjham-cc": true,
    "turn-divider@kjham-cc": true,
    "slide-craft@kjham-cc": true,
    "agent-radar@kjham-cc": true
  }
}
